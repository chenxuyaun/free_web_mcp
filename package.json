{
  "name": "free-web-mcp",
  "version": "0.4.0",
  "private": true,
  "description": "Free Web MCP - Verifiable Web Evidence Network (MCP server + evidence engine + Next.js dashboard + BSC Testnet anchoring)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @free-web-mcp/web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "mcp:dev": "cd apps/mcp-server && uv run --no-sync free-web-mcp",
    "mcp:test": "cd apps/mcp-server && uv run --no-sync pytest -q",
    "demo": "tsx scripts/demo.ts",
    "dev:all": "concurrently -k -n mcp,web -c yellow,cyan \"pnpm mcp:dev\" \"pnpm dev\"",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "tsx": "^4.23.12",
    "typescript-eslint": "^8.68.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "patchedDependencies": {
      "@bnb-chain/reed-solomon": "patches/@bnb-chain__reed-solomon.patch"
    }
  }
}