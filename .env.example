# Free Web MCP - Verifiable Web Evidence Network

NODE_ENV=development

NEXT_PUBLIC_APP_NAME=Free Web MCP

# Blockchain (BSC Testnet ONLY in v1)
BSC_NETWORK=bsc-testnet
BSC_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
BSC_EXPLORER_URL=https://testnet.bscscan.com
# EVIDENCE_REGISTRY_ADDRESS is filled in after Phase 5 deploy.

# Server-side wallet signer (TESTNET ONLY - never put a real key here)
WALLET_PRIVATE_KEY=

# Web Engine limits
MAX_SEARCH_RESULTS=10
MAX_PAGE_SIZE=5000000
REQUEST_TIMEOUT=30000

# Python MCP server (apps/mcp-server)
MCP_SERVER_URL=http://127.0.0.1:8765
