# Copy to deploy/.env on the server and fill in.
# deploy/.env is git-ignored — secrets never enter the repo.

# Your domain (A record -> server IP). Caddy issues HTTPS automatically.
DOMAIN=your-domain.com
# Optional: email for Let's Encrypt expiry notices
ACME_EMAIL=you@example.com

# Chain (BSC Testnet only)
BSC_NETWORK=bsc-testnet
BSC_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
BSC_EXPLORER_URL=https://testnet.bscscan.com
EVIDENCE_REGISTRY_ADDRESS=0xD4F14929A1694932439DDa1D481aA127f80185D7
VERI_TOKEN_ADDRESS=0x4FF843Db5196B3Ca7438ABe6E3d6FC16d94350Da

# Server-side testnet signer (MetaMask-exported test key — never a mainnet key)
WALLET_PRIVATE_KEY=

# BNB Greenfield (optional — enables evidence publishing)
GREENFIELD_BUCKET=free-web-mcp-evidence2
